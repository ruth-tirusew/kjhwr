# Copy to .env. docker compose reads it automatically; for `make api` export the same variables.

# Backend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000   # comma-separated; whitespace is trimmed
DEFAULT_CUTOFF=09:00                                       # HH:MM UK time on D-1
SNAPSHOT_DIR=data/snapshots                                # where snapshots live (the Docker image sets /app/data/snapshots)
SNAPSHOT_ID=20261102T080553Z                               # optional: pin the served snapshot; empty = newest

# Front end (build-time)
VITE_API_URL=http://localhost:8000
